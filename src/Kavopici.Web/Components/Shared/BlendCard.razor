@inject IThemedLocalizer L

<div class="about-box @(Locked ? "locked" : "")">
    <div class="about-box-content @(IsClickable ? "clickable" : "")"
         role="@(IsClickable ? "link" : null)"
         tabindex="@(IsClickable ? "0" : null)"
         title="@(IsClickable ? L["Btn_OpenDetail"].ToString() : null)"
         @onclick="HandleClick"
         @onclick:stopPropagation="IsClickable"
         @onkeydown="HandleKeyDown"
         @onkeydown:stopPropagation="IsClickable">
        <div class="blend-name">@Blend.Name</div>
        <div class="blend-meta">
            @Blend.Roaster
            @if (!string.IsNullOrEmpty(Blend.Origin))
            {
                <span> · @Blend.Origin</span>
            }
            <span> · </span><RoastBadge Level="Blend.RoastLevel" />
        </div>
        <div class="blend-supplier">
            @L["Label_Supplier"]: @Blend.Supplier.Name
            @if (Blend.WeightGrams.HasValue) { <span> · @Blend.WeightGrams.Value g</span> }
            @if (Blend.PriceCzk.HasValue) { <span> · @Blend.PriceCzk.Value.ToString("F0") Kč</span> }
            @if (Blend.PricePerKg.HasValue) { <span> (@Blend.PricePerKg.Value.ToString("F0") Kč/kg)</span> }
        </div>
    </div>
    @if (Locked)
    {
        <div class="lock-overlay">
            <div class="lock-pill">🔒 @L["Msg_RevealAfterRating"]</div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public CoffeeBlend Blend { get; set; } = null!;
    [Parameter] public bool Locked { get; set; }

    /// <summary>Invoked when the (unlocked) blend info is clicked, e.g. to open the blend detail.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    // Never clickable while locked, so the secret blend is not revealed before voting.
    private bool IsClickable => !Locked && OnClick.HasDelegate;

    private async Task HandleClick()
    {
        if (IsClickable) await OnClick.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (IsClickable && (e.Key == "Enter" || e.Key == " ")) await OnClick.InvokeAsync();
    }
}
